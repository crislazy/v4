---
import MainLayout from "../layouts/mainLayout.astro"
const buttonCode = '<a href="https://crislzy.xyz" target="_blank"><img src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif" width="88px" height="31px" alt="crislzy.xyz"></a>'
---

<MainLayout title="Home">
    <div class="abt">
        <img src="https://cdn.hackclub.com/01a096bf-e2cb-7e4c-aa9e-98303a253dce/pfp.png" alt="profile picture"/>
        <div class="abt-content">
            <h2>Stuff about me</h2>
            <p>I'm Cris and I'm a teen developer(kinda) and a <a href="https://hackclub.com">Hack Club</a> member.</p>
            <p>I like to code random stuff like websites and bots and I enjoy self-hosting.</p>
            <p>I have a Raspberry Pi home server that is currently ofline because SD card is corrupted.</p>
            <p>I have 2 lists of tech and software I use: <a href="/tech.txt">tech</a> and <a href="/software.txt">software</a></p>
        </div>
    </div>
    <h3>My statuses</h3>
    <div class="statuses">
        <p>I'm <span id="discord-status">(couldn't load)</span><b title="Status from Discord" style="position: relative; cursor: pointer; font-size: 10px; top: -8px;">(?)</b></p>
        <script src="/js/discord.js" is:inline></script>
        <p><span id="lastfm-prefix">Last played:</span> <span id="lastfm-song">(couldn't load)</span><b title="From LastFM" style="position: relative; cursor: pointer; font-size: 10px; top: -8px;">(?)</b></p>
        <script src="/js/lastfm.js" is:inline></script>
    </div>
    <br>
    <p>Btw, here is my cool ass button</p>
    <img src="https://user-cdn.hackclub-assets.com/019ed4b1-6838-746d-a6a4-1402670fe71c/88x31.gif" />
    <textarea readonly>{buttonCode}</textarea>
    <br>
    <h2>My really cool coding stats</h2>
    <img
        src="https://github-readme-stats.hackclub.dev/api/wakatime?username=22875&api_domain=hackatime.hackclub.com&hide_title=true&theme=vision-friendly-dark&layout=compact&cache_seconds=0&langs_count=8"
        alt="Hackatime coding statistics"
        loading="lazy"
        class="hackatime-stats"
    />
    <br>
    <h2>Contact me(pls, I have no friends :/)</h2>
    <ul>
        <li>Email: <a href="mailto:me@crislzy.xyz">me [at] crislzy [dot] xyz</a></li>
        <li>HackClub Slack: <a href="https://hackclub.enterprise.slack.com/team/U09TNMQ9MCZ" target="_blank" rel="noopener noreferrer me">CrisLzy</a></li>
        <li>Github: <a href="https://github.com/crislazy" target="_blank" rel="noopener noreferrer me">Crislazy</a></li>
        <li>Discord: <a href="https://discord.com/users/1528816581105156200" target="_blank" rel="noopener noreferrer me">Cris(@someone_named_cris)</a></li>
        <li>Discord Server: <a href="https://r.webcris.icu/discord" target="_blank" rel="noopener noreferrer me">here :3</a></li>
        <li>Boykisser Page: <a href="https://boykisser.gg/@cris" target="_blank" rel="noopener noreferrer me">here :3</a></li>
    </ul>
    <br>
    <h2>Cool Websites</h2>
    <div class="buttons">
        <a href="https://alexanderisashy.one" target="_blank">
            <img
                src="https://cdn.hackclub.com/019eb7f6-9096-7359-9ae6-b5d5c4bfa22f/gateway.png"
                alt="alexanderisashy.one"
